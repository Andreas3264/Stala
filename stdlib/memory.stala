# memory

func malloc bytes do
	setup_mem
	
	mem_start let ptr
	ptr mem_start ?ptr + let ptr
	ptr sizeof(ptr) + let ptr

	mem_start mem_start ?ptr bytes + !ptr

	ptr ret
end

func get_memory_use do
	mem_start ?ptr ret
end

#
# private functions
#

func setup_mem do
	"A" let ptr
	ptr ?8 0 = if ret end
	ptr 0 !8

	mem_start 0 !ptr
end


