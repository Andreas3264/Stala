# x86 64 utility

func UTIL_DO_NOT_CALL do
	ret

asm ";; start of utility functions\n"

asm "
;; push rax to the data stack
push_rax:
push rbx
mov rbx, [rel dsp]
mov [rbx], rax
add rbx, 8
mov [rel dsp], rbx
pop rbx
ret
"

asm "
;; pop rax from the data stack
pop_rax:
push rbx
mov rbx, [rel dsp]
sub rbx, 8
mov rax, [rbx]
mov [rel dsp], rbx
pop rbx
ret
"

asm "
;; push rbx to the data stack
push_rbx:
push rax
mov rax, rbx
call push_rax
pop rax
ret
"

asm "
;; pop rbx from the data stack
pop_rbx:
push rax
call pop_rax
mov rbx, rax
pop rax
ret
"

asm "
;; push rcx to the data stack
push_rcx:
push rax
mov rax, rcx
call push_rax
pop rax
ret
"

asm "
;; pop rcx from the data stack
pop_rcx:
push rax
call pop_rax
mov rcx, rax
pop rax
ret
"

asm "
;; push rdx to the data stack
push_rdx:
push rax
mov rax, rdx
call push_rax
pop rax
ret
"

asm "
;; pop rdx from the data stack
pop_rdx:
push rax
call pop_rax
mov rdx, rax
pop rax
ret
"

asm "
;; push rdi to the data stack
push_rdi:
push rax
mov rax, rdi
call push_rax
pop rax
ret
"

asm "
;; pop rdi from the data stack
pop_rdi:
push rax
call pop_rax
mov rdi, rax
pop rax
ret
"

asm "
;; push rsi to the data stack
push_rsi:
push rax
mov rax, rsi
call push_rax
pop rax
ret
"

asm "
;; pop rsi from the data stack
pop_rsi:
push rax
call pop_rax
mov rsi, rax
pop rax
ret
"

asm "
;; push r10 to the data stack
push_r10:
push rax
mov rax, r10
call push_rax
pop rax
ret
"

asm "
;; pop r10 from the data stack
pop_r10:
push rax
call pop_rax
mov r10, rax
pop rax
ret
"

asm "
;; push r9 to the data stack
push_r9:
push rax
mov rax, r9
call push_rax
pop rax
ret
"

asm "
;; pop r9 from the data stack
pop_r9:
push rax
call pop_rax
mov r9, rax
pop rax
ret
"

asm "
;; push r8 to the data stack
push_r8:
push rax
mov rax, r8
call push_rax
pop rax
ret
"

asm "
;; pop r8 from the data stack
pop_r8:
push rax
call pop_rax
mov r8, rax
pop rax
ret
"

asm "
;; push local variable with index rax
pushl:
shl rax, 3
mov rbx, [rel lsp]
sub rbx, rax
mov rax, [rbx]
call push_rax
ret
"

asm "
;; pop local variable with index rax
popl:
shl rax, 3
mov rbx, [rel lsp]
sub rbx, rax
call pop_rax
mov [rbx], rax
ret
"

asm "
;; increment local stack by rax
incl:
shl rax, 3
mov rbx, [rel lsp]
add rax, rbx
mov [rel lsp], rax
ret
"

asm "
;; decrement local stack by rax
decl:
shl rax, 3
mov rbx, [rel lsp]
sub rbx, rax
mov [rel lsp], rbx
ret
"

asm ";; end of utility functions"

end