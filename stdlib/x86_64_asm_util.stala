# x86 64 utility

func UTIL_DO_NOT_CALL do
	ret

asm ";; start of utility functions\n"

asm "
;; push rax to the data stack
push_rax:
push rbx
mov rbx, [rel dsp]
mov [rbx], rax
add rbx, 8
mov [rel dsp], rbx
pop rbx
ret
"

asm "
;; pop rax from the data stack
pop_rax:
push rbx
mov rbx, [rel dsp]
sub rbx, 8
mov rax, [rbx]
mov [rel dsp], rbx
pop rbx
ret
"

asm "
;; push rbx to the data stack
push_rbx:
push rax
mov rax, [rel dsp]
mov [rax], rbx
add rax, 8
mov [rel dsp], rax
pop rax
ret
"

