include "stdlib/stdlib.stala"
include "compiler/tokenizer.stala"
include "compiler/token.stala"
include "compiler/parser.stala"
include "compiler/compiler_objects.stala"
include "compiler/code_generator.stala"
include "compiler/error_reporter.stala"
include "compiler/interpreter.stala"

func main argc argv do

	#"ARGC: " print argc print_int "" println
	#argv let ar
	#while ar ?ptr 0 != do
	#	"ARG: " print
	#	ar ?ptr println
	#	ar sizeof(ptr) + let ar
	#end

	argc 2 < if "not enough arguments\n" error fail end

	argv ?ptr let path_to_self  argv sizeof(ptr) + let argv # path to this compiler
	argv ?ptr let path_to_input argv sizeof(ptr) + let argv # path to the program to compile/interpret

	"" let path_to_output

	while argv ?ptr 0 != do
		argv ?ptr let argument
		
		argument "-out" streq if
			argv sizeof(ptr) + let argv
			argv ?ptr 0 = if "missing argument after -out\n" error fail end
			argv ?ptr let path_to_output
			argv sizeof(ptr) + let argv
		else
			"unknown argument: " error argument error "\n" error fail
		end
	end

	path_to_input parser_parse_program let program

	path_to_output strlen 0 != if
		# compiler mode
		path_to_output create_and_open_file let out_file
		out_file new_file_writer let file_writer
		output_file file_writer !ptr
		program code_gen
		file_writer file_writer_close
	else
		# interpreter mode
		program interpret
	end

	"Memory use: " print get_memory_use print_int "\n" print
end

func output_file do "01234567" end

func print_output_enabled do false end

func out_asm str do
	print_output_enabled if str print end
	output_file ?ptr let file_writer
	file_writer str file_writer_write_string
end

func out_asm_number val do
	"01234567 01234567" let number_buffer
	number_buffer val 10 int_to_str
	number_buffer out_asm
end

func tmp_label_string do
	"01234567 01234567 01234567 01234567 01234567 01234567 01234567 01234567"
end

func out_jump_zero_token token do
	tmp_label_string let label
	label "t_" strcpy
	label label strlen + token token_get_guid 10 int_to_str
	label out_jump_zero
end

func out_jump_token token do
	tmp_label_string let label
	label "t_" strcpy
	label label strlen + token token_get_guid 10 int_to_str
	label out_jump
end

func out_label_token token do
	tmp_label_string let label
	label "t_" strcpy
	label label strlen + token token_get_guid 10 int_to_str
	label out_label
end

func str_unescape dst src do
	# ignore first "
	src ++ let src 
	while src ?8 0 != do
		src ?8 let char
		char "\"" ?8 = if
			# must be end of string
			dst 0 !8
		else char "\\" ?8 = elif
			src ++ let src
			src ?8 let char

			char "\\" ?8 = if
				dst "\\" ?8 !8
			else char "\"" ?8 = elif
				dst "\"" ?8 !8
			else char "n" ?8 = elif
				dst "\n" ?8 !8
			else char "t" ?8 = elif
				dst "\t" ?8 !8
			else char "s" ?8 = elif
				dst "\s" ?8 !8 # space
			else
				# TODO: should the error reporter be here?
				"invalid escape character: " error "?\n" dup char !8 error
				reporter_report error fail
			end
			dst ++ let dst
		else
			dst char !8
			dst ++ let dst
		end
		src ++ let src
	end
end