
func status_tokenize_spacers do 1 end
func status_tokenize_token   do 2 end
func status_tokenize_string  do 3 end
func status_tokenize_escaped do 4 end
func status_tokenize_comment do 5 end
func status_tokenize_number  do 6 end

func spacers do "\s\t\n" end
func number_chars do "0123456789" end
func token_first_chars do "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_+-*<=>(){}[]?!:/%" end
func token_chars do "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_+-*<=>(){}[]?!:/%" end
func escaped_chars do "nts\\\"" end

func new_tokenizer do
	4 new_array let tokenizer
	1024 malloc let buffer
	tokenizer buffer tokenizer_set_token_buffer
	tokenizer null tokenizer_set_token
	tokenizer status_tokenize_spacers tokenizer_set_status
	tokenizer true tokenizer_set_is_lexing_token
	tokenizer ret
end

func tokenizer_get_token_buffer tokenizer do tokenizer 0 array_get_index end
func tokenizer_set_token_buffer tokenizer buffer do tokenizer 0 buffer array_set_index end
func tokenizer_get_token tokenizer do tokenizer 1 array_get_index end
func tokenizer_set_token tokenizer token do tokenizer 1 token array_set_index end
func tokenizer_get_status tokenizer do tokenizer 2 array_get_index end
func tokenizer_set_status tokenizer status do tokenizer 2 status array_set_index end
func tokenizer_get_is_lexing_token tokenizer do tokenizer 3 array_get_index end
func tokenizer_set_is_lexing_token tokenizer is_lexing_token do tokenizer 3 is_lexing_token array_set_index end

#
# returns token
#
func tokenizer_next_token tokenizer input_file do
	tokenizer status_tokenize_spacers tokenizer_set_status
	tokenizer new_token tokenizer_set_token
	tokenizer tokenizer_get_token_buffer let token_string
	token_string 0 !8
	
	#build token
	tokenizer true tokenizer_set_is_lexing_token
	while tokenizer tokenizer_get_is_lexing_token do
		tokenizer input_file tokenizer_next_char
	end

	tokenizer tokenizer_get_token let token
	token token_string strdup token_set_text
	token ret
end

func tokenizer_next_char tokenizer input_file do

	tokenizer tokenizer_get_token_buffer let token_string
	tokenizer tokenizer_get_token let token
	tokenizer tokenizer_get_status let lexer_status
	tokenizer tokenizer_get_is_lexing_token let lexing_token

	input_file file_read_char let char
	char "\n" ?8 = if
		report_newline
	end
	
	lexer_status status_tokenize_spacers = if

			spacers char strchr null != if
			# do nothing
			status_tokenize_spacers let lexer_status

		else char "\"" ?8 = elif
			# begining of string
			token token_type_string token_set_type
			token_string char strcatchr
			status_tokenize_string let lexer_status

		else token_first_chars char strchr null != elif
			# begining of token
			token token_type_identifier token_set_type
			token_string char strcatchr
			status_tokenize_token let lexer_status

		else number_chars char strchr null != elif
			# number
			token token_type_number token_set_type
			token_string char strcatchr
			status_tokenize_token let lexer_status
		
		#else char "-" ?8 = elif #TODO improve
		#	# negative number
		#	token token_type_number token_set_type
		#	token_string char strcatchr
		#	status_tokenize_token let lexer_status
		#
		#else char "+" ?8 = elif
		#	# positive number
		#	token token_type_number token_set_type
		#	token_string char strcatchr
		#	status_tokenize_token let lexer_status
		#
		else char "#" ?8 = elif
			# begining of comment
			status_tokenize_comment let lexer_status
		
		else char EOF = elif
			# end of file reached
			false let lexing_token
			
		else
			"invalid character: " error
			"?\n" dup char !8  error
			reporter_report error fail
			
		end
		
	else lexer_status status_tokenize_token = elif
	
		spacers char strchr null != if
			# end of token reached
			false let lexing_token
			
		else token_chars char strchr null != elif
			# continue token
			token_string char strcatchr
			status_tokenize_token let lexer_status
		
		else char EOF = elif
			# end of file reached
			false let lexing_token
			
		else
			"invalid character in token: " error
			"?\n" dup char !8  error
			reporter_report error fail
				
		end
	
	else lexer_status status_tokenize_string = elif
		
		char "\\" ?8 = if
			# escaped character
			token_string char strcatchr
			status_tokenize_escaped let lexer_status
	
		else char "\"" ?8 = elif
			# end of string
			token_string char strcatchr
			false let lexing_token
		
		else char EOF = elif
			# end of file reached
			"invalid EOF in string\n" error
			reporter_report error fail
		else
			# continue string
			token_string char strcatchr
			status_tokenize_string let lexer_status
			
		end
	
	else lexer_status status_tokenize_escaped = elif
	
		escaped_chars char strchr null != if
			# continue string
			token_string char strcatchr
			status_tokenize_string let lexer_status
		
		else
			"invalid character escaped character: " error
			"?\n" dup char !8 error
			reporter_report error fail
			
		end
	
	else lexer_status status_tokenize_comment = elif
	
		char "\n" ?8 = if
			# end of comment
			status_tokenize_spacers let lexer_status
		
		else char EOF = elif
			# end of file reached
			false let lexing_token
		
		else
			# character in comment
		end
	
	else
		"unimplementad lexer status\n" error fail 
	end
	
	tokenizer lexer_status tokenizer_set_status
	tokenizer lexing_token tokenizer_set_is_lexing_token
end