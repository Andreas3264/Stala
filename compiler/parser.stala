
func parser_parse_program input_file_name do

	new_program let program
	
	token_init

	init_reporter
	input_file_name report_begin_source

	new_list let include_list
	include_list input_file_name list_add

	while include_list list_get_size 0 != do
		include_list list_pop let include_string
				
		include_string try_open_file let input_file
		input_file -1 = if
			include_string error_report_missing_file
		end
		include_string report_begin_source

		input_file new_file_reader let file_reader
		file_reader new_list tokenizer_tokenize let tokens
		file_reader file_reader_close		

		new_source let source
		source include_string source_set_name
		program program_get_source_list source list_add
		tokens include_list program source parser_parse_source
	end
	program ret
end


func parser_parse_source tokens include_list program source do
	
	1024 malloc let buffer
	
	tokens list_reverse
	while tokens list_get_size 0 != do

		tokens list_peek let token
		token token_get_text let token_text

		token_text "func" streq if
			new_function let function
			function token token_get_guid function_set_index
			source source_get_function_list function list_add
			tokens source function parser_parse_function

			#check function name collisions
			program function function_get_name program_search_for_function let other_function
			other_function null != if
				#TODO set correct token, can be EOF
				#tokens list_peek report_set_token
				other_function error_report_duplicate_function
			end
			program program_get_function_list function list_add

			function function_get_name "main" streq if
				program function program_set_main_function
			end
			
		else token_text "include" streq elif
			tokens include_list buffer parser_parse_include
		else
			"unexpected token in source: " error
			token_text error "\n" error
			reporter_report error fail
		end
	end
end

# start -> include
# end -> after "source.stala"
func parser_parse_include tokens include_list tmp_buffer do
	
	tokens list_pop
	#TODO set reporter status
	tokens error_report_assert_not_empty
	tokens list_pop let token

	token report_set_token
	token token_get_type token_type_string error_report_assert_token_type

	token token_get_text let token_string
	tmp_buffer token_string str_unescape
	tmp_buffer strdup let include_string
	include_list include_string list_push
end

# start -> func
# end -> after end
func parser_parse_function tokens source function do
	tokens parser_parse_function_name let function_name
	function function_name function_set_name
	function function_get_local_list let local_list
	tokens local_list parser_parse_function_args
	function local_list list_get_size function_set_arg_c
	local_list list_reverse
	tokens source function parser_parse_block
end

# start -> func
# end -> arg1 or do
# returns function name
func parser_parse_function_name tokens do
	tokens list_pop let void	
	#TODO set reporter status
	tokens error_report_assert_not_empty

	tokens list_peek report_set_token
	tokens list_peek token_get_type token_type_identifier error_report_assert_token_type

	tokens list_pop token_get_text let function_name
	function_name report_begin_function
	function_name ret
end

# start -> arg1 or do
# end -> after do
func parser_parse_function_args tokens locals_list do

	while true do
		#TODO set reporter status
		tokens error_report_assert_not_empty
		
		tokens list_pop let token
		token token_get_text let token_string

		token_string "do" streq if
			ret
		end
		
		token report_set_token
		token token_get_type token_type_identifier error_report_assert_token_type

		locals_list token_string list_add		
	end
end


# start -> after do
# end -> after end
# returns body
func parser_parse_block tokens source function do

	function function_get_body let token_list	
	new_list let block_stack 

	while true do
		#TODO set reporter status
		tokens error_report_assert_not_empty

		tokens list_pop let token
		token token_get_text let token_string
		token_list token list_add
		
		token_string "while" streq if
			new_list let chain
			chain token list_add
			block_stack chain list_push
		else token_string "do" streq elif
			block_stack list_get_size 0 = if
				"missing block before do" error_report_block_error
			end
			block_stack list_peek let chain
			chain 0 list_get_index token_get_text "while" streq false = if
				"missing while before do" error_report_block_error
			end
			chain token list_add
		else token_string "if" streq elif
			new_list let chain
			chain token list_add
			block_stack chain list_push
		else token_string "elif" streq elif
			block_stack list_get_size 0 = if
				"missing block before elif" error_report_block_error
			end
			block_stack list_peek let chain
			chain list_peek token_get_text "else" streq false = if
				"missing else before elif" error_report_block_error
			end
			chain token list_add
		else token_string "else" streq elif
			block_stack list_get_size 0 = if
				"missing block before else" error_report_block_error
			end
			block_stack list_peek let chain
			chain list_peek token_get_text "if" streq false = if
				chain list_peek token_get_text "elif" streq false = if
					"missing if/elif before else" error_report_block_error
				end
			end
			chain token list_add
		else token_string "end" streq elif
			block_stack list_get_size 0 = if
				# end of function
				report_end_function
				ret
			else
				block_stack list_pop let chain
				chain list_peek token_get_text "do" streq if
					# end of while-do
					chain token list_add
					chain handle_while_chain
				else chain list_peek token_get_text "if" streq elif
					# end of if-end
					chain token list_add
					chain handle_if_chain
				else chain list_peek token_get_text "elif" streq elif
					# end of if-else-elif-end
					chain token list_add
					chain handle_if_chain
				else chain list_peek token_get_text "else" streq elif
					# end of if/elif-else end
					chain token list_add
					chain handle_if_chain
				else chain list_peek token_get_text "while" streq elif
					# invalid while-end
					"while-end" error_report_block_error
				else
					"invalid chain token" error_report_unreachable
				end
			end
		else token_string "ret" streq elif
			# nothing to do here
		else token_string "let" streq elif
			tokens parser_parse_let let local_name
			token local_name token_set_data
			function function_get_local_list let local_list
			local_list local_name list_add
		else token_string "asm" streq elif
			tokens parser_parse_asm let asm_string
			token asm_string token_set_data
		else token token_get_type token_type_number = elif
			# nothing to do here
		else token_string "-1" streq elif #TODO:improve, quick fix for negative number -1
			# nothing to do here
		else token token_get_type token_type_identifier = elif 
			# local variable or function call
		else token token_get_type token_type_string = elif
			function function_get_string_list token list_add
		else
			"unexpected token in function body: " error
			token_string error "\n" error
			reporter_report error fail
		end
	end
end

func handle_if_chain chain do
	chain list_peek let last_token	
	0 let i
	while chain list_get_size i != do
		chain i list_get_index let token
		token token_get_text let token_string
		
		token_string "if" streq if
			# jump zero to next -> (else or end)
			chain i ++ list_get_index let next_token
			token next_token token_set_data
		else token_string "elif" streq elif
			# jump zero to next -> (else or end)
			chain i ++ list_get_index let next_token
			token next_token token_set_data
		else token_string "else" streq elif
			# jump to end
			token last_token token_set_data
		else token_string "end" streq elif
			# do nothing
		else
			"invalid if chain" error_report_unreachable
		end
		i ++ let i
	end
end

func handle_while_chain chain do
	chain 0 list_get_index let while_token
	chain 1 list_get_index let do_token
	chain 2 list_get_index let end_token
	# while gets just a label
	# do is jump_zero to end
	do_token end_token token_set_data
	# end is jump to while
	end_token while_token token_set_data
end

# start -> after let
# end -> after identifier
# returns variable name
func parser_parse_let tokens do
	tokens error_report_assert_not_empty
	tokens list_peek report_set_token
	tokens list_peek token_get_type token_type_identifier error_report_assert_token_type
	tokens list_pop token_get_text let local_name
	local_name ret
end

# start -> after asm
# end -> after " "
# returns asm string
func parser_parse_asm tokens do
	#TODO set reporter status
	tokens error_report_assert_not_empty
	tokens list_peek report_set_token
	tokens list_peek token_get_type token_type_string error_report_assert_token_type
	tokens list_pop token_get_text let asm_string
	asm_string ret
end